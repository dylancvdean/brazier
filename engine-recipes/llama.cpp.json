{
  "id": "llama.cpp",
  "display_name": "llama.cpp",
  "upstream_origins": [
    "https://github.com/ggml-org/llama.cpp.git",
    "https://github.com/ggml-org/llama.cpp"
  ],
  "supported_platforms": ["linux-x64", "linux-arm64", "macos-x64", "macos-arm64", "windows-x64", "windows-arm64"],
  "steps": [
    {
      "label": "Configure",
      "program": "cmake",
      "args": ["-S", "{source}", "-B", "{build}", "-DCMAKE_BUILD_TYPE=Release", "-DBUILD_SHARED_LIBS=OFF", "-DLLAMA_BUILD_SERVER=ON", "-DLLAMA_BUILD_TESTS=OFF", "-DLLAMA_BUILD_EXAMPLES=OFF", "{target_flags}"]
    },
    {
      "label": "Build server",
      "program": "cmake",
      "args": ["--build", "{build}", "--config", "Release", "--target", "llama-server", "--parallel", "{parallel}"]
    }
  ]
}
