{
  "id": "stable-diffusion.cpp",
  "display_name": "stable-diffusion.cpp",
  "upstream_origins": [
    "https://github.com/leejet/stable-diffusion.cpp.git",
    "https://github.com/leejet/stable-diffusion.cpp"
  ],
  "supported_platforms": [
    "linux-x64",
    "linux-arm64",
    "macos-x64",
    "macos-arm64",
    "windows-x64",
    "windows-arm64"
  ],
  "steps": [
    {
      "label": "Configure",
      "program": "cmake",
      "args": [
        "-S",
        "{source}",
        "-B",
        "{build}",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DSD_BUILD_SHARED_LIBS=OFF",
        "-DSD_BUILD_EXAMPLES=ON",
        "{target_flags}"
      ]
    },
    {
      "label": "Build CLI",
      "program": "cmake",
      "args": [
        "--build",
        "{build}",
        "--config",
        "Release",
        "--target",
        "sd-cli",
        "--parallel",
        "{parallel}"
      ]
    }
  ]
}
