{
  "name": "brazier",
  "version": "0.1.0",
  "private": true,
  "description": "A private, cross-platform workbench for local language models.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @brazier/desktop dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check && cargo check --workspace",
    "test": "pnpm -r test && cargo test --workspace",
    "format:check": "cargo fmt --all --check"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
