{
  "name": "brazier",
  "version": "0.2.13-beta.73",
  "private": true,
  "description": "A private, cross-platform workbench for local language models.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "pnpm --filter @brazier/desktop dev",
    "dev:welcome": "pnpm --filter @brazier/desktop dev:welcome",
    "dev:wayland": "pnpm --filter @brazier/desktop exec env ELECTRON_OZONE_PLATFORM_HINT=wayland electron-vite dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check && cargo check --workspace",
    "test": "pnpm -r test && pnpm qualification:test && pnpm qualification:voice-corpus && cargo test --workspace",
    "format:check": "cargo fmt --all --check",
    "qualification:test": "node --test scripts/release-version.test.mjs scripts/verify-beta-qualification.test.mjs",
    "qualification:voice-corpus": "node scripts/qualify-silero-vad.mjs",
    "qualification:verify": "node scripts/verify-beta-qualification.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish"
  },
  "engines": {
    "node": ">=24"
  }
}
