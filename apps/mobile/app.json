{
  "expo": {
    "name": "Brazier",
    "slug": "brazier-mobile",
    "version": "0.1.0",
    "icon": "../desktop/build/icon.png",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "ai.brazier.mobile",
      "appleTeamId": "4U2WZ7WJT4",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your own Brazier host on your local network.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [{
              "UISceneConfigurationName": "Default Configuration",
              "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
            }]
          }
        }
      }
    },
    "android": {
      "package": "ai.brazier.mobile"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Allow Brazier to scan a pairing invite.",
        "recordAudioAndroid": false,
        "barcodeScannerEnabled": true
      }],
      "expo-secure-store",
      "./plugins/with-ios-scenes.cjs",
      "./plugins/with-tls-pinning.cjs"
    ]
  }
}
