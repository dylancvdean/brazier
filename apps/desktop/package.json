{
  "name": "@brazier/desktop",
  "version": "0.3.1-beta.1",
  "private": true,
  "author": "Dylan C. V. Dean",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "desktopName": "brazier",
  "description": "Brazier desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm run build:agent && electron-vite dev",
    "dev:welcome": "pnpm run build:agent && BRAZIER_FORCE_WELCOME=1 electron-vite dev",
    "dev:x11": "pnpm run build:agent && ELECTRON_OZONE_PLATFORM_HINT=x11 electron-vite dev",
    "build": "pnpm run build:agent && electron-vite build",
    "build:agent": "node scripts/build-agent-worker.mjs",
    "watch:agent": "node scripts/build-agent-worker.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run && node --test scripts/wrap-linux-launcher.node-test.mjs",
    "package": "pnpm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.74.0",
    "onnxruntime-web": "1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.brazier.desktop",
    "executableName": "brazier",
    "productName": "Brazier",
    "publish": [
      {
        "provider": "github",
        "owner": "dylancvdean",
        "repo": "brazier",
        "releaseType": "draft"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/agent/**"
    ],
    "extraResources": [
      {
        "from": "../../target/release",
        "to": "bin",
        "filter": [
          "brazierd",
          "brazierd.exe",
          "brazier-safety",
          "brazier-safety.exe",
          "brazier-input-guard"
        ]
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "afterPack": "./scripts/wrap-linux-launcher.mjs",
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "Brazier.AppImage"
    },
    "dmg": {
      "artifactName": "Brazier.dmg"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Brazier-Setup.exe"
    }
  }
}
