{
  "name": "@brazier/desktop",
  "version": "0.2.9-beta.27",
  "private": true,
  "author": "Dylan C. V. Dean",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "desktopName": "brazier",
  "description": "Brazier desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm run build:agent && env -u WAYLAND_DISPLAY ELECTRON_OZONE_PLATFORM_HINT=x11 electron-vite dev",
    "dev:welcome": "pnpm run build:agent && env -u WAYLAND_DISPLAY ELECTRON_OZONE_PLATFORM_HINT=x11 BRAZIER_FORCE_WELCOME=1 electron-vite dev",
    "build": "pnpm run build:agent && electron-vite build",
    "build:agent": "node scripts/build-agent-worker.mjs",
    "watch:agent": "node scripts/build-agent-worker.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "package": "pnpm run build && electron-builder --dir"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@ricky0123/vad-web": "0.0.30",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.brazier.desktop",
    "executableName": "brazier",
    "productName": "Brazier",
    "publish": [
      {
        "provider": "github",
        "owner": "dylancvdean",
        "repo": "brazier",
        "releaseType": "draft"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "out/agent/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../../target/release",
        "to": "bin",
        "filter": [
          "brazierd",
          "brazierd.exe"
        ]
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "Brazier.AppImage"
    },
    "dmg": {
      "artifactName": "Brazier.dmg"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
